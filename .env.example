# ── Required ──────────────────────────────────────────────────────────────────
# Minimum needed to boot the dev server. Everything else is optional.
PUBLIC_PB_PORT=8090

# ── Dev Superuser (optional) ─────────────────────────────────────────────────
# When set, seeds this superuser on `task dev` and uses it for `task typegen`.
# Leave blank (or omit) to skip superuser seeding and type generation.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# ── Bootstrap Superuser (optional, ALL builds incl. prod/beta) ────────────────
# Env-driven superuser bootstrap that runs in every build (unlike the dev-only
# seeder above). When both are set and no superuser with this email exists yet,
# the server creates it on boot; an existing one is left untouched. No-op when
# unset. Set these on beta so you have an admin without a manual PB console step.
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_PASSWORD=

# ── Discord Bot (optional) ────────────────────────────────────────────────────
# Server runs fine without these — you'll see a warning log and bot features
# will be disabled. Set both to enable the bot.
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=

# ── OAuth2 Providers (optional) ───────────────────────────────────────────────
# Leave both fields blank to disable a provider. Set ID + secret to enable.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Containers (optional) ─────────────────────────────────────────────────────
# Set CONTAINERS_ENABLED=true to expose /api/admin/containers/* and start the
# socket-discovery watcher. Requires rooted Podman + KVM/DRI passthrough +
# `_default.qcow2` baseline at $CONTAINERS_SHARED_DIR/hdds/. See CLAUDE.md.
CONTAINERS_ENABLED=false
CONTAINERS_SOCKET_DIR=./containers/xemu/qmp
CONTAINERS_SHARED_DIR=./containers/xemu/shared
CONTAINERS_INIT_DIR=./containers/xemu/init
CONTAINERS_CONFIGS_DIR=./containers/xemu/configs
CONTAINERS_BROWSER_DIR=./containers/browser
CONTAINERS_BROWSER_INIT_DIR=./containers/browser/init
CONTAINERS_PORT_BASE=3100
CONTAINERS_PORT_STRIDE=10
CONTAINERS_HOST_IP=localhost

# ── xemu pcap network interface (NETIF) ───────────────────────────────────────
# NOT read from THIS file. It belongs in $CONTAINERS_INIT_DIR/.env
# (containers/xemu/init/.env), which is bind-mounted at /custom-cont-init.d and
# sourced by 02-patch-toml.sh inside the container. Documented here because this
# is where an operator looks for container knobs.
#
# It pins the host interface xemu's pcap backend binds for System Link. Leave it
# unset and the container autodetects the first carrier-up physical NIC,
# skipping virtual / bridge / bond / wireless / VPN interfaces. Set it when the
# host has more than one physical NIC and the Xboxes are on a specific one —
# autodetect cannot know which, and binding the wrong NIC presents as "System
# Link works but Halo is laggy" rather than as an obvious failure.
#
#   NETIF=enp191s0

# How the server invokes podman. Default "podman" runs rootless under the
# server user — fine for `podman create`, but `podman start` will fail on
# device passthrough (KVM/DRI/NET_ADMIN). Set to "sudo -n podman" to escalate;
# requires a passwordless sudoers rule. See CLAUDE.md "Containers".
#
# `--runtime=crun` is required: with the default OCI runtime on some hosts
# (runc 1.4.x), the jlesage/firefox sidecar's Xvnc rejects all X clients with
# "Authorization required, but no authorization protocol specified" and the
# noVNC view stays black. crun handles the same image cleanly. Install via
# `sudo pacman -S crun` (or distro equivalent).
CONTAINERS_PODMAN_CMD=sudo -n podman --runtime=crun

# HDD overlays + console naming (M26). The canonical read-only root qcow2 that
# every per-instance copy-on-write overlay backs onto (keep in sync with
# DEFAULT_HDD_NAME in containers/xemu/init/.env); the host qemu-img used to
# create overlays; and the create-time Xbox console-name write
# (E:\UDATA\NICKNAME.XBN). Console naming is best-effort — if the toolchain
# (qemu-storage-daemon + python3 + pyfatx) is missing it's skipped with a
# warning and the instance keeps the Xbox random default. Set
# CONTAINERS_SET_CONSOLE_NAME=false to disable it entirely.
CONTAINERS_ROOT_HDD=_default.qcow2
CONTAINERS_QEMU_IMG_CMD=qemu-img
CONTAINERS_SET_CONSOLE_NAME=true
CONTAINERS_QEMU_STORAGE_DAEMON_CMD=qemu-storage-daemon
CONTAINERS_PYTHON_CMD=python3
# Path to the pyfatx console-name helper. Empty = default
# <CONTAINERS_INIT_DIR>/../tools/fatx_console_name.py.
CONTAINERS_FATX_TOOL=

# Screen reverse-proxy timeouts (all milliseconds). SCREEN_LIVE_TIMEOUT bounds the
# pre-dial `podman inspect` liveness probe so a hung podman can't stall a screen
# request. SCREEN_DIAL_TIMEOUT is the total budget the proxy spends retrying the
# TCP dial to a running-but-still-booting browser container; SCREEN_PER_DIAL is
# the per-attempt cap so a filtered port can't stall a single dial past that
# budget. Defaults preserve the historical ~10s boot-race window.
CONTAINERS_SCREEN_LIVE_TIMEOUT_MS=2000
CONTAINERS_SCREEN_DIAL_TIMEOUT_MS=10000
CONTAINERS_SCREEN_PER_DIAL_TIMEOUT_MS=3000

# Selkies streaming defaults (passed to xemu container as -e flags)
CONTAINERS_ENCODER=x264enc
CONTAINERS_FRAMERATE=60
CONTAINERS_CRF=20
CONTAINERS_WIDTH=960
CONTAINERS_HEIGHT=720
CONTAINERS_PIXELFLUX_WAYLAND=true
CONTAINERS_DRINODE=/dev/dri/renderD128
CONTAINERS_SHM_SIZE=1g
CONTAINERS_BROWSER_SHM_SIZE=2gb

# Overlay/spectator tokens (M10). Read-only OBS overlay tokens are HS256-signed
# (tokens won't survive a restart — set this in production). Default token
#
# signs overlay tokens with a random secret regenerated on every boot, so every
# minted token silently becomes invalid after a restart. ALWAYS set a stable
# secret in production.

# ── WebSocket (optional) ──────────────────────────────────────────────────────
# Comma-separated allowlist of Origin patterns permitted to open the /api/ws
# WebSocket (and the screen VNC relay).
#
# ⚠ SECURITY (fail-open default): when UNSET, all origins are accepted
# (InsecureSkipVerify) for dev convenience — this widens the cross-site
# WebSocket-hijacking surface. Auth (JWT / overlay token) is still required, but
# set this to your public origin(s) in production, e.g.
# WS_ALLOWED_ORIGINS=https://lan.example.com
WS_ALLOWED_ORIGINS=

# ── LAN Saves (optional) ──────────────────────────────────────────────────────
# Endpoints under /api/lan/saves for staging Xbox save artifacts.
#
# ⚠ SECURITY (fail-open default): when LAN_SAVES_TOKEN is UNSET the endpoints
# are OPEN (no auth) — the intended default for a trusted LAN. Set a token to
# require it via the X-LAN-Token header (or ?token=) for exposed deployments.
LAN_SAVES_TOKEN=
# Staging dir for in-flight save artifacts. Empty = the OS temp dir.
LAN_SAVES_STAGING_DIR=
# FATX cluster size (bytes) for save packing. Empty = built-in default.
LAN_SAVES_FATX_CLUSTER=

# ── xc-scraper daemon (optional, step 8 R1 wire mode) ─────────────────────────
# Set XC_SCRAPER_URL to consume the sibling xc-scraper daemon instead of the
# embedded runner (DESIGN-STEP8 D-4). Set ⇒ "wire mode": no in-process runner,
# no league-side discovery watcher, live state mirrored from the daemon's
# WebSocket stream, control through its /api/ctl/* routes. Unset ⇒ in-process
# mode exactly as before. Boot prints `leaguescraper: mode=wire|in-process …`
# (docs/RUNBOOK.md). Rollback: stop the daemon unit (or unset its webhook)
# BEFORE restarting the league without this — two attachers on one QMP dir
# persist every finished game twice.
#
# http(s)://host[:port] only — a ws:// scheme or a path component is a boot
# error ("leaguescraper: XC_SCRAPER_URL must be http(s)://host[:port]").
XC_SCRAPER_URL=
# Daemon feed token (its --token); blank when the daemon runs open.
XC_SCRAPER_TOKEN=
# Daemon control token (its --control-token) for /api/ctl/* (start/stop, host
# drive, config push). Blank ⇒ the daemon's control routes must be open.
XC_SCRAPER_CONTROL_TOKEN=
# Shared secret the daemon presents on POST /api/xc/finished_game (its
# --webhook-token). While set it is imported as an in-memory machine key with
# the scraper.ingest scope (all builds); the authz boot report nags when unset.
XC_SCRAPER_WEBHOOK_TOKEN=
# Stream silence after which the mirror clears (D-12): box/play auth then
# fails closed except for rostergrace's 5-min window. Go duration, > 0.
XC_SCRAPER_STALE_AFTER=60s
# XC_SCRAPER_INGEST_FROM_STREAM (D-7, default false) is reserved: finished
# games are ingested from the webhook only; no code reads the flag yet.

# Host-runner flags are read in BOTH modes. In-process: gate + drive policy
# of the embedded host runner (ADR-0003). Wire: HOSTRUNNER_ENABLED joins the
# daemon's xc:hostrunner room and lets the reaper poll GET /api/instances/
# {name}/host; HOSTRUNNER_DRIVE_MARKER is pushed per instance in the control
# config (§10). Both leave the league at R2.
HOSTRUNNER_ENABLED=false
HOSTRUNNER_DRIVE_MARKER=play-

# --- xc-scraper daemon: the dev loop (step 8 D1) ------------------------------
# `task dev` / `task dev:lan` run the daemon under Air from ../xc-scraper on
# 127.0.0.1:8992 (task dev:scraper). The Taskfile sets XC_SCRAPER_LISTEN,
# XC_SCRAPER_WATCH_DIR (containers/xemu/qmp), XC_SCRAPER_GAME_WEBHOOK
# (http://127.0.0.1:$PUBLIC_PB_PORT/api/xc/finished_game) and
# XC_SCRAPER_STATE_DIR (../xc-scraper/tmp/xc-scraper-state); every other daemon
# flag has an XC_SCRAPER_<UPPER_SNAKE> twin that is read from this file too
# (XC_SCRAPER_TOKEN / XC_SCRAPER_CONTROL_TOKEN / XC_SCRAPER_WEBHOOK_TOKEN are
# shared with the league; XC_SCRAPER_HOSTRUNNER=true when HOSTRUNNER_ENABLED).
# The league only CONSUMES the dev daemon when XC_SCRAPER_URL points at it;
# unset = in-process runner (and, with CONTAINERS_ENABLED=true, both would
# attach the same qmp dir). Tiers: 8990 prod / 8991 pre (deploy/README.md in
# ../xc-scraper). Uncomment for the daemon-backed dev loop:
# XC_SCRAPER_URL=http://127.0.0.1:8992
